{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "VITE_APIFY_API_KEY": "@apify_api_key",
    "VITE_ETHERSCAN_API_KEY": "@etherscan_api_key",
    "VITE_LINDY_API_KEY": "@lindy_api_key"
  }
}

